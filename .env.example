PORT=3005
DATABASE_URL="postgresql://user:pass@localhost:5432/zanapo_ai"
REDIS_URL="redis://localhost:6379"

LLM_PROVIDER=openai
OPENAI_API_KEY=xxx
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_TOPIC_IDEAS=gpt-4.1-nano
OPENAI_MODEL_DEEP_RESEARCH=gpt-4.1
OPENAI_MODEL_OUTLINE=gpt-4.1-mini
OPENAI_MODEL_WRITER=gpt-4.1
OPENAI_MODEL_SEO_EDITOR=gpt-4.1
OPENAI_MODEL_HTML_VALIDATOR=gpt-4.1-mini
OPENAI_MODEL_FINAL_PACKAGER=gpt-4.1-mini
OPENAI_MODEL_WEB_DESCRIPTION=gpt-4.1
OPENAI_MODEL_WEB_DESCRIPTION_V2=gpt-4.1
OPENAI_MODEL_WEB_DESCRIPTION_SK=gpt-4.1

# Optional: pricing overrides (USD per 1M tokens) for cost reporting
OPENAI_PRICE_GPT_4_1_INPUT_PER_1M=2.0
OPENAI_PRICE_GPT_4_1_OUTPUT_PER_1M=8.0
OPENAI_PRICE_GPT_4_1_MINI_INPUT_PER_1M=0.4
OPENAI_PRICE_GPT_4_1_MINI_OUTPUT_PER_1M=1.6
OPENAI_PRICE_GPT_4_1_NANO_INPUT_PER_1M=0.1
OPENAI_PRICE_GPT_4_1_NANO_OUTPUT_PER_1M=0.4

# Optional: SQL output settings for product description update
WEB_DESCRIPTION_SQL_TABLE=product_translation
WEB_DESCRIPTION_SQL_PRODUCT_ID_COLUMN=product_id
WEB_DESCRIPTION_SQL_LANGUAGE_ID_COLUMN=language_id
WEB_DESCRIPTION_SQL_NAME_COLUMN=name
WEB_DESCRIPTION_SQL_SHORT_COLUMN=description_short
WEB_DESCRIPTION_SQL_LONG_COLUMN=description

# Optional: search volume enrichment for topic ideas (Google Ads API)
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_oauth_refresh_token
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v19
GOOGLE_ADS_LANGUAGE_CONSTANT_ID=1029
GOOGLE_ADS_GEO_TARGET_CONSTANT_ID=2203
KEYWORD_LOCATION_NAME=Czechia (2203)
KEYWORD_LANGUAGE_NAME=Czech (1029)

# Optional: stronger product research via Google Programmable Search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
